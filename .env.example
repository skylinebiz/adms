# --- App server ---
PORT=8080
# Max request body size for device-facing /iclock/* routes. Anything
# bytes()-parseable ("10mb", "5242880", etc). Raise only if real firmware
# is sending FACE/FINGERTMP/photo payloads that exceed it - each in-flight
# request buffers its whole body in memory, so this is a memory tradeoff,
# not a knob to bump reflexively. An oversized payload still gets acked OK
# (retrying an identical oversized payload would just fail forever) but is
# logged loudly and NOT recorded - see Raw Request Log in the admin panel.
ADMS_MAX_BODY_SIZE=10mb

# How long (ms) after a device's last contact it's still shown as ONLINE
# in the admin UI. A device polls/heartbeats every few seconds up to a
# couple of minutes in normal operation, so this should comfortably cover
# a few missed cycles without flapping on one delayed request. Status is
# computed at read time, not stored - raising/lowering this takes effect
# immediately, no backfill needed.
DEVICE_OFFLINE_THRESHOLD_MS=300000

# --- Database ---
# For docker-compose this is set automatically to point at the postgres service.
DATABASE_URL=postgresql://adms:adms@localhost:5432/adms

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_SESSION_COOKIE_NAME=adms_admin

# --- Bootstrap super-admin (only used the very first time the AdminUser table is empty) ---
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-immediately

# --- Webhook worker ---
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=8000
WORKER_POLL_INTERVAL_MS=3000
WORKER_BATCH_SIZE=50
