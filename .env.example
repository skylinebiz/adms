# --- App server ---
PORT=8080

# --- Database ---
# For docker-compose this is set automatically to point at the postgres service.
DATABASE_URL=postgresql://adms:adms@localhost:5432/adms

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_SESSION_COOKIE_NAME=adms_admin

# --- Bootstrap super-admin (only used the very first time the AdminUser table is empty) ---
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-immediately

# --- Webhook worker ---
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=8000
WORKER_POLL_INTERVAL_MS=3000
WORKER_BATCH_SIZE=50
