generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  COMPANY_ADMIN
}

enum DeviceStatus {
  UNKNOWN
  ONLINE
  OFFLINE
}

enum DeviceCommandStatus {
  PENDING
  SENT
  ACKED
  FAILED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  // URL-safe, globally unique slug chosen at signup (or by a super_admin
  // creating a company manually) - the first path segment of every device
  // under this company's Cloud Server URL: /<slug>/<deviceSecret>/iclock/...
  // and the company scope a pending device's first-contact ping resolves
  // to. See src/utils/slug.ts for format/reserved-word rules.
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminUsers     AdminUser[]
  devices        Device[]
  pendingDevices PendingDevice[]

  @@map("companies")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(COMPANY_ADMIN)
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mustChangePassword Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId])
  @@map("admin_users")
}

model Device {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serialNumber   String       @unique
  label          String?
  status         DeviceStatus @default(UNKNOWN)
  lastSeenAt     DateTime?

  // Path secret the device's own Cloud Server URL is configured with
  // (`http://host:port/<deviceSecret>`, firmware appends /iclock/... after
  // that). Not required to be globally unique - lookup is always by SN,
  // this only validates the request against the SN it claims. null means
  // "never secured" and stays fully open on the legacy plain /iclock path.
  deviceSecret        String?

  // IANA timezone name (e.g. "Asia/Kolkata") the device's own clock is set
  // to. Devices push wall-clock digits with no timezone info of their own
  // (see parseDeviceDatetime in src/adms/parsers/attlog.ts) - this is what
  // lets the server work out the real UTC instant behind those digits.
  // Nullable and opt-in: null (the default) means "unknown", and every
  // existing punch-time behavior is completely unchanged. Setting it only
  // affects punches ingested afterward - PunchRecord.punchTimeUtc is never
  // retroactively backfilled for older rows.
  timezone            String?

  webhookUrl          String?
  webhookSecret       String?
  webhookEnabled      Boolean  @default(false)
  // Extra headers sent with every webhook request, e.g. {"Authorization": "Bearer xyz"}.
  // Values may reference punch placeholders (see webhookBodyTemplate) too.
  webhookHeaders       Json?
  // Custom JSON request body. String leaves may contain {{placeholder}} tokens
  // (pin, punch_time, punch_time_unix, status, verify_mode, work_code,
  // device_id, device_serial, company_id, company_name, received_at).
  // A leaf that is *exactly* "{{name}}" is replaced with the typed value
  // (number/string); placeholders embedded in a larger string are
  // stringified and interpolated. Null/unset falls back to the default
  // punch.created payload shape.
  webhookBodyTemplate  Json?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  punchRecords   PunchRecord[]
  commands       DeviceCommand[]
  rawLogs        DeviceRawLog[]

  @@index([companyId])
  @@map("devices")
}

model PunchRecord {
  id           String   @id @default(cuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  devicePin    String
  // The device's literal wall-clock digits, stamped as UTC (NOT a real UTC
  // instant - see parseDeviceDatetime). Unchanged from day one: still the
  // dedupe key, still what the admin UI shows as "exactly what the device's
  // clock reported."
  punchTime    DateTime
  // The actual UTC instant, computed from punchTime's digits via the
  // device's configured timezone at ingestion time (see zonedWallClockToUtc
  // in src/adms/timezone.ts). Null when the device had no timezone
  // configured yet at the moment this punch arrived - never backfilled
  // later, so a null here just means "not knowable," not "midnight UTC."
  punchTimeUtc DateTime?
  status       Int
  verifyMode   Int
  workCode     String?
  reserved1    String?
  reserved2    String?
  rawLine      String

  receivedAt   DateTime @default(now())

  webhookDelivered   Boolean   @default(false)
  webhookAttempts    Int       @default(0)
  nextAttemptAt      DateTime  @default(now())
  lastWebhookError   String?
  webhookDeliveredAt DateTime?
  // True when this punch was ingested while its device had no webhook
  // configured (or webhook disabled). Held records are never auto-picked-up
  // by the worker, even after a webhook gets configured later - only new
  // punches (ingested after configuration) or an explicit admin retry
  // (which clears this flag) become eligible. Prevents a burst of stale
  // backlog punches firing the moment someone sets a webhook URL.
  webhookHeld        Boolean   @default(false)

  deliveries   WebhookDelivery[]

  @@unique([deviceId, devicePin, punchTime, status, verifyMode], name: "dedupe_key")
  @@index([webhookDelivered, nextAttemptAt])
  @@index([deviceId, punchTime])
  @@map("punch_records")
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  punchRecordId String
  punchRecord   PunchRecord @relation(fields: [punchRecordId], references: [id], onDelete: Cascade)

  url           String
  attempt       Int
  statusCode    Int?
  responseBody  String?
  delivered     Boolean
  error         String?

  createdAt     DateTime @default(now())

  @@index([punchRecordId])
  @@map("webhook_deliveries")
}

// Stub command queue for /iclock/getrequest + /iclock/devicecmd.
model DeviceCommand {
  id        String              @id @default(cuid())
  deviceId  String
  device    Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  command   String
  status    DeviceCommandStatus @default(PENDING)
  response  String?
  createdAt DateTime            @default(now())
  sentAt    DateTime?
  ackedAt   DateTime?

  @@index([deviceId, status])
  @@map("device_commands")
}

// Raw log of any /iclock/* request from an SN not (yet) registered as a Device,
// so an admin can "claim" it into a company later.
model UnregisteredDevicePing {
  id           String   @id @default(cuid())
  serialNumber String
  endpoint     String
  method       String
  query        String?
  rawBody      String?
  createdAt    DateTime @default(now())

  @@index([serialNumber])
  @@map("unregistered_device_pings")
}

// One row per not-yet-claimed SN, summarizing what's currently known about
// it - in particular the secret it's been pinging with, if any, captured on
// first contact so it carries straight through to the Device record when an
// admin claims it (no separate provisioning step). See deviceLookup.ts for
// the adopt/no-adopt rules that keep `secret` from being silently
// overwritten by a mismatched later ping.
model PendingDevice {
  id           String   @id @default(cuid())
  serialNumber String   @unique
  secret       String?
  // Company resolved from the URL's slug segment at first-contact time
  // (see resolveCompanyIdFromSlug/upsertPendingDevice in deviceLookup.ts).
  // Null covers legacy /iclock pings and unresolved/typo'd slugs - those
  // stay in the global/unscoped bucket, visible only to super_admin. Once
  // set, never reassigned by a later ping - same first-write-wins rule as
  // `secret`, so a pending SN can't be squatted away from the company that
  // first made contact with it.
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  pingCount    Int      @default(1)

  @@index([companyId])
  @@map("pending_devices")
}

// Raw dump of any non-ATTLOG data a *registered* device pushes to
// /iclock/cdata - OPERLOG, USERINFO, FINGERTMP, FACE, photos, or any other
// table name a firmware variant sends. Punches (ATTLOG) still go through
// PunchRecord; this is everything else, browsable per device for debugging
// what a device is actually sending. Company-scoped in the admin API.
model DeviceRawLog {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  endpoint  String
  method    String
  table     String?
  query     String?
  headers   String?
  rawBody   String?
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
  @@map("device_raw_logs")
}

// Unconditional firehose of *every* /iclock/* request (registered or not,
// any table), for super-admin-only low-level debugging across the whole
// platform. Deliberately not scoped to a company/device - it's the "what is
// actually hitting this server" view. Overlaps with UnregisteredDevicePing
// and DeviceRawLog by design (those are curated subsets of this).
model RawRequestLog {
  id           String   @id @default(cuid())
  serialNumber String?
  endpoint     String
  method       String
  query        String?
  headers      String?
  rawBody      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([serialNumber])
  @@map("raw_request_logs")
}
